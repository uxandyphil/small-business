# API
PORT=8787
# DB_PATH=./data/tracker.db

# Run enabled non-demo sources every N hours while the server is up (0 = off)
INGEST_EVERY_HOURS=0
# Complete crawls a listing must be missing from before it is marked off-market
MISSES_BEFORE_OFF_MARKET=2
# Identify your crawler honestly
CRAWLER_USER_AGENT="ColumbusBizTracker/0.1 (+https://your-site.example/bot)"

# Licensed marketplace feeds (only with a data license / partner agreement)
# BIZBUYSELL_FEED_URL=
# BIZBUYSELL_API_KEY=
# BIZQUEST_FEED_URL=
# BIZQUEST_API_KEY=

# Email alerts (optional). Without SMTP_URL, alerts are in-app only.
# SMTP_URL=smtps://user:pass@smtp.example.com
# ALERT_FROM=alerts@your-site.example
# PUBLIC_URL=https://your-site.example
